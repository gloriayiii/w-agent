# ---- Neon Postgres ----
# MUST be the "Pooled connection" string (hostname contains -pooler).
# A direct connection will exhaust the connection limit under serverless.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ---- Anthropic ----
ANTHROPIC_API_KEY="sk-ant-..."

# ---- DeepSeek (cheap model for internal tasks) ----
DEEPSEEK_API_KEY="sk-..."

# ---- Telegram ----
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
# Only this chat id is processed; everyone else is ignored.
# This is the entire auth model.
TELEGRAM_OWNER_CHAT_ID="123456789"
# Generate with: openssl rand -hex 32
# Telegram echoes this back in a request header on every webhook call.
TELEGRAM_WEBHOOK_SECRET="<openssl rand -hex 32>"

# ---- Deployment URL (used by scripts/set-webhook.ts) ----
PUBLIC_BASE_URL="https://your-project.vercel.app"

# ---- Shared secret for the /api/tick cron and the /trace page ----
CRON_SECRET="<openssl rand -hex 32>"

# ---- Your timezone. Drives quiet hours and "what time is it" reasoning. ----
TZ_NAME="Asia/Shanghai"
